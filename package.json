{
  "name": "smart-classroom-attendance-portal",
  "version": "2.0.0",
  "description": "Smart Classroom & Attendance Analytics Portal with Computer Vision",
  "private": true,
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
